# 复制到 ../.local-dev/backend.env，根据本机环境填写后用 ". ../.local-dev/backend.env" 加载。
# 数据库、对象存储和私钥配置仅保存在本地文件中。
export AIBERTAI_DATABASE_URL='postgres://aibertai:REPLACE_DATABASE_PASSWORD@127.0.0.1:55432/aibertai?sslmode=disable'
export AIBERTAI_HTTP_ADDR='127.0.0.1:8080'
# Vite 是开发入口，OAuth 与员工端登录使用浏览器可访问的统一 origin。
export AIBERTAI_PUBLIC_URL='http://127.0.0.1:5173'
export AIBERTAI_S3_ENDPOINT='http://127.0.0.1:59000'
export AIBERTAI_S3_FORCE_PATH_STYLE='true'
export AIBERTAI_S3_ACCESS_KEY='REPLACE_S3_ACCESS_KEY'
export AIBERTAI_S3_SECRET_KEY='REPLACE_S3_SECRET_KEY'
# export AIBERTAI_S3_BUCKET='aibertai-resources'
# export AIBERTAI_S3_REGION='us-east-1'

# 仅空库首次启动需要管理员账号与至少 12 字符的密码。
export AIBERTAI_INITIAL_ADMIN_EMAIL='admin@example.com'
export AIBERTAI_INITIAL_ADMIN_PASSWORD='REPLACE_ME'
# export AIBERTAI_INITIAL_ADMIN_NAME='AIbertAI 管理员'

# 开发启动从本目录执行。可改用绝对路径，目录须由后端进程持久保存。
export AIBERTAI_RUNTIME_STATE_DIR='../.local-dev/runtime'
# export AIBERTAI_RUNTIME_RELAY='false'
# export AIBERTAI_RUNTIME_DESKTOP_ORIGINS='http://127.0.0.1:5173'
# export AIBERTAI_RUNTIME_FILES_ORIGIN='https://files.example.com'
# export AIBERTAI_RUNTIME_PREVIEW_ORIGIN_TEMPLATE='https://{artifact}.preview.example.net'

# 可选，从私有后端提供已落盘的设计目录和媒体。
# export AIBERTAI_DESIGN_PUBLIC_CACHE_DIR='../.local-dev/design-cache'

# 当 Go 后端监听地址与默认值不同时，同步设置管理端代理目标。
# export AIBERTAI_DEV_BACKEND_URL='http://127.0.0.1:8080'
