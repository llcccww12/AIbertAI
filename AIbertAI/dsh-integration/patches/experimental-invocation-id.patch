@@ -0,0 +1,72 @@
+import { mkdtemp, rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { Context } from '@deepseek-ai/cordis'
+import { mountAgentLoopTestDependencies } from '@deepseek-ai/dsh-agent-loop-testkit'
+import AgentLoop from '@deepseek-ai/dsh-agent-loop'
+import * as JsonlSessionPersistence from '@deepseek-ai/dsh-session-persistence-jsonl'
+import { MockAdapter } from '../../../core/agent-loop/tests/mock-adapter.ts'
+import { expect, it, vi } from 'vitest'
+import { HarnessSdkJsonRpcServer } from '../src/server.ts'
+
+it('preserves reasoning, attempt settlement and turn identity', async () => {
+  const root = await mkdtemp(join(tmpdir(), 'sdk-reasoning-'))
+  const ctx = new Context()
+  await mountAgentLoopTestDependencies(ctx)
+  await ctx.plugin(AgentLoop, { agents: [] })
+  await ctx.plugin(JsonlSessionPersistence, { root })
+  const adapter = new MockAdapter([[
+    { type: 'block-start', index: 0, blockType: 'reasoning' },
+    { type: 'reasoning-delta', index: 0, text: 'first thought' },
+    { type: 'block-end', index: 0, block: { type: 'reasoning', text: 'first thought' } },
+    { type: 'block-start', index: 1, blockType: 'text' },
+    { type: 'text-delta', index: 1, text: 'answer' },
+    { type: 'block-end', index: 1, block: { type: 'text', text: 'answer' } },
+    { type: 'finish', reason: { kind: 'stop' } },
+  ], { hangAfter: [
+    { type: 'block-start', index: 0, blockType: 'reasoning' },
+    { type: 'reasoning-delta', index: 0, text: 'interrupted thought' },
+  ] }])
+  ctx.llm.registerAdapter(['mock-reasoning'], adapter)
+  const frames: { sessionId: string; aibertaiOperationId?: string; frame: { type: string; attemptId: string; revision: number; chunk?: { type: string; text: string }; outcome?: { kind: string; eventType?: string } } }[] = []
+  const endings: { aibertaiOperationId?: string; event: { type: string; data: { reason?: { kind?: string } } } }[] = []
+  const server = new HarnessSdkJsonRpcServer(ctx, {
+    request: async () => { throw new Error('unexpected host request') },
+    notify: (method, params) => {
+      if (method === 'aibertai/assistant-stream') frames.push(params as typeof frames[number])
+      if (method === 'session.event') endings.push(params as typeof endings[number])
+    },
+  })
+  const sessionId = '11111111-1111-4111-8111-111111111111'
+  const operations = ['22222222-2222-4222-8222-222222222222', '33333333-3333-4333-8333-333333333333'] as const
+  const bind = async (operationId: string) => server.handleRequest('aibertai/turn-bind', { sessionId, operationId, workspaceBridge: false, hostTools: [], expertInstructions: '' })
+  const prompt = async (operationId: string) => server.handleRequest('session/prompt', { sessionId, aibertaiOperationId: operationId, contentBlocks: [{ type: 'text', text: 'fixture' }] })
+  try {
+    await server.handleRequest('initialize', { cwd: root, provider: 'mock-reasoning', model: 'mock', aibertaiLeaseSessionId: sessionId })
+    await bind(operations[0])
+    for (const text of ['hello', '/goal resume', '/goal clear extra', '/goal edit ']) {
+      await expect(server.handleRequest('session/query', { sessionId, aibertaiLeaseOperationId: operations[0], contentBlocks: [{ type: 'text', text }] })).rejects.toThrow('invalid lease control command')
+    }
+    await expect(server.handleRequest('session/query', { sessionId, aibertaiLeaseOperationId: operations[1], contentBlocks: [{ type: 'text', text: '/goal clear' }] })).rejects.toThrow()
+    await expect(server.handleRequest('session/query', { sessionId, aibertaiLeaseOperationId: operations[0], aibertaiOperationId: operations[0], contentBlocks: [{ type: 'text', text: '/goal clear' }] })).rejects.toThrow('invalid lease control command')
+    await prompt(operations[0]); await server.handleRequest('session/wait', { sessionId })
+    await server.handleRequest('aibertai/turn-release', { sessionId, operationId: operations[0] })
+    await bind(operations[1]); await prompt(operations[1])
+    await vi.waitFor(() => expect(frames.some(item => item.frame.chunk?.text === 'interrupted thought')).toBe(true))
+    expect(await server.handleRequest('aibertai/session-cancel', { sessionId })).toEqual({ accepted: true })
+    await server.handleRequest('session/wait', { sessionId })
+    const first = frames.filter(item => item.aibertaiOperationId === operations[0])
+    const second = frames.filter(item => item.aibertaiOperationId === operations[1])
+    expect(first.map(item => item.frame.type)).toEqual(['start', 'chunk', 'chunk', 'end'])
+    expect(first.filter(item => item.frame.type === 'chunk').map(item => item.frame.chunk)).toEqual([
+      { type: 'reasoning-delta', index: 0, text: 'first thought' }, { type: 'text-delta', index: 1, text: 'answer' },
+    ])
+    expect(first.at(-1)?.frame.outcome).toMatchObject({ kind: 'committed', eventType: 'assistant/message' })
+    expect(second.map(item => item.frame.type)).toEqual(['start', 'chunk', 'end'])
+    expect(second[1]?.frame.chunk).toEqual({ type: 'reasoning-delta', index: 0, text: 'interrupted thought' })
+    expect(second.at(-1)?.frame.outcome).toMatchObject({ kind: 'committed', eventType: 'assistant/message' })
+    expect(endings.filter(item => item.aibertaiOperationId === operations[1] && item.event.type === 'turn/end').at(-1)?.event.data.reason).toMatchObject({ kind: 'aborted' })
+    expect(first[0]?.frame.attemptId).not.toBe(second[0]?.frame.attemptId)
+    for (let i = 1; i < frames.length; i++) expect(frames[i]!.frame.revision).toBeGreaterThan(frames[i - 1]!.frame.revision)
+  } finally { await server.shutdown(); await ctx.fiber.dispose(); await rm(root, { recursive: true, force: true }) }
+})
