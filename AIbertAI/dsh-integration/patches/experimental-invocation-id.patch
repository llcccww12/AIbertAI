+}, 120_000)
+
+
+it('recovers workspace evidence after SDK process was killed', async () => {
+  const storageDir = process.env.DSH_BOUNDARY_RESTART_ROOT
+  const fixturePath = process.env.DSH_BOUNDARY_FIXTURE_OUTPUT
+  if (!storageDir || !fixturePath) return
+  const expected = JSON.parse(await readFile(fixturePath, 'utf8')) as { sessionId: string; operationId: string; callId: string; callSeq: number }
+  const ctx = await makeHarness(storageDir)
+  ctx.llm.registerAdapter(['boundary-mock'], new MockAdapter([]))
+  const server = new HarnessSdkJsonRpcServer(ctx, new FakeTransport())
+  try {
+    await server.initialize({ cwd: storageDir, provider: 'boundary-mock', model: 'mock', aibertaiLeaseSessionId: expected.sessionId })
+    await server.handleRequest('session/resume', { sessionId: expected.sessionId })
+    const params = { sessionId: expected.sessionId, operationId: expected.operationId, callId: expected.callId, callSeq: expected.callSeq }
+    const actual = await server.handleRequest('aibertai/workspace-proof', params)
+    expect(actual).toEqual(expected)
+    const events = (expected as typeof expected & { proofSeq: number; events: unknown[] }).events
+    for (const [i, part] of ['call', 'result', 'proof'].entries()) {
+      const page = await server.handleRequest('aibertai/workspace-proof', { ...params, part }) as { proofSeq: number; events: unknown[] }
+      expect(page.proofSeq).toBe((expected as typeof expected & { proofSeq: number }).proofSeq)
+      expect(page.events).toEqual([events[i]])
+    }
+  } finally { await server.shutdown(); await ctx.fiber.dispose() }
+}, 120_000)
+
+
+it('does not recover workspace evidence when SDK died before its receipt', async () => {
+  const storageDir = process.env.DSH_BOUNDARY_INCOMPLETE_ROOT
+  const prefixPath = process.env.DSH_BOUNDARY_PREFIX_OUTPUT
+  if (!storageDir || !prefixPath) return
+  const page = JSON.parse(await readFile(prefixPath, 'utf8')) as { sessionId: string; events: { seq: number; type: string; data: { callId?: string } }[] }
+  const call = page.events.find(event => event.type === 'tool/call' && event.data.callId === 'call-1')
+  if (!call) throw new Error('missing persisted call')
+  const ctx = await makeHarness(storageDir)
+  ctx.llm.registerAdapter(['boundary-mock'], new MockAdapter([]))
+  const server = new HarnessSdkJsonRpcServer(ctx, new FakeTransport())
+  try {
+    await server.initialize({ cwd: storageDir, provider: 'boundary-mock', model: 'mock', aibertaiLeaseSessionId: page.sessionId })
+    await server.handleRequest('session/resume', { sessionId: page.sessionId })
+    await expect(server.handleRequest('aibertai/workspace-proof', { sessionId: page.sessionId, operationId: '22222222-2222-4222-8222-222222222222', callId: 'call-1', callSeq: call.seq })).rejects.toThrow('workspace proof unavailable')
+  } finally { await server.shutdown(); await ctx.fiber.dispose() }
+}, 120_000)
