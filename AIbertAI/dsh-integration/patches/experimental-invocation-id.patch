@@ -0,0 +1,36 @@
+/** Experimental publisher; platform must keep the target inaccessible until receipt verification. */
+import type { Context } from '@deepseek-ai/cordis'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { buildImportSeed } from './history-import-seed.ts'
+import type { Prepared, ImportReceipt, ImportPublisher } from './history-import-prototype.ts'
+
+export class HistoryImportPublisher implements ImportPublisher {
+  constructor(private readonly ctx: Context, private readonly cwd: string) {}
+  async commit(prepared: Prepared): Promise<ImportReceipt> {
+    const persistence = this.ctx.get('sessionPersistence')
+    if (!persistence) throw new Error('import_persistence_unavailable')
+    const session = Session.create(SessionId(prepared.targetSessionId))
+    const header = {...session.header, cwd:this.cwd}
+    const writer = await persistence.create(header)
+    try {
+      await writer.append(buildImportSeed(prepared))
+      await writer.flush()
+    } finally { await writer.close() }
+    return this.reconcile(prepared)
+  }
+  async reconcile(prepared: Prepared): Promise<ImportReceipt> {
+    const persistence = this.ctx.get('sessionPersistence')
+    if (!persistence) throw new Error('import_persistence_unavailable')
+    // Write ownership excludes a still-running publisher, including in another
+    // process. Never infer success from the presence of a target alone.
+    const handle = await persistence.open(SessionId(prepared.targetSessionId), 'write')
+    try {
+      if (handle.header.id !== prepared.targetSessionId || handle.header.cwd !== this.cwd) throw new Error('import_target_mismatch')
+      await handle.flush()
+      const expected = buildImportSeed(prepared)
+      const result = await handle.read(0, expected.length + 1)
+      if (JSON.stringify(result.events) !== JSON.stringify(expected)) throw new Error('import_history_mismatch')
+      return {version:1,migrationId:prepared.migrationId,targetSessionId:prepared.targetSessionId,sourceSha256:prepared.sourceSha256,messages:prepared.messages,status:'committed'}
+    } finally { await handle.close() }
+  }
+}
