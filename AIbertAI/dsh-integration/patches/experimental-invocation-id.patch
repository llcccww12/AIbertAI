index 0000000..968bf72
--- /dev/null
+++ b/packages/sdk/server/src/aibertai-settlement.ts
@@ -0,0 +1,46 @@
+/** Fail-closed correlation of a gateway invocation to a durable session record. */
+
+type Entry = { type: string; seq: number; data: Record<string, unknown> }
+type Usage = { inputTokens: number; outputTokens: number; totalTokens?: number; cacheReadTokens?: number; cacheWriteTokens?: number; reasoningTokens?: number }
+export type AIbertSettlement = { state: 'committed' | 'failed' | 'unknown'; seq?: number; usageSeq?: number; usage?: Usage }
+
+function durableUsage(entry: Entry): Pick<AIbertSettlement, 'usageSeq' | 'usage'> {
+  const raw = entry.data['usage']
+  if (raw === null || typeof raw !== 'object' || Array.isArray(raw)) return {}
+  const data = raw as Record<string, unknown>
+  const keys = ['inputTokens', 'outputTokens', 'totalTokens', 'cacheReadTokens', 'cacheWriteTokens', 'reasoningTokens'] as const
+  if (!keys.every(key => data[key] === undefined || (typeof data[key] === 'number' && Number.isSafeInteger(data[key]) && data[key] >= 0))) return {}
+  if (typeof data['inputTokens'] !== 'number' || typeof data['outputTokens'] !== 'number') return {}
+  const usage: Usage = { inputTokens: data['inputTokens'], outputTokens: data['outputTokens'] }
+  for (const key of keys.slice(2)) if (typeof data[key] === 'number') usage[key as keyof Usage] = data[key]
+  return { usageSeq: entry.seq, usage }
+}
+
+export function aibertSettlement(events: readonly Entry[], invocationId: string): AIbertSettlement {
+  const unknown: AIbertSettlement = { state: 'unknown' }
+  const starts = events.filter(e => e.type === 'aibertai/invocation' && e.data['invocationId'] === invocationId)
+  if (starts.length !== 1) return unknown
+  const start = starts[0]!
+  if (start.data['purpose'] === 'conversation') {
+    const ends = events.filter(e => (e.type === 'assistant/message' || e.type === 'assistant/attempt') && e.data['invocationId'] === invocationId)
+    if (ends.length !== 1 || ends[0]!.seq <= start.seq) return unknown
+    const end = ends[0]!
+    const success = end.type === 'assistant/message' && end.data['interrupted'] !== true
+      && (end.data['invocationFinish'] === 'stop' || end.data['invocationFinish'] === 'tool-calls')
+    return { state: success ? 'committed' : 'failed', seq: end.seq, ...(success ? durableUsage(end) : {}) }
+  }
+  if (start.data['purpose'] !== 'compaction' || typeof start.data['compactionId'] !== 'string') return unknown
+  const compactionId = start.data['compactionId']
+  const related = events.filter(e => e.type === 'aibertai/invocation' && e.data['compactionId'] === compactionId)
+  const begins = events.filter(e => e.type === 'compaction/start' && e.data['compactionId'] === compactionId)
+  const ends = events.filter(e => e.type === 'compaction/end' && e.data['compactionId'] === compactionId)
