+++ b/packages/sdk/server/tests/aibertai-turn-lease.spec.ts
@@ -0,0 +1,29 @@
+import { describe, expect, it } from 'vitest'
+import { AibertaiTurnLease } from '../src/aibertai-turn-lease.ts'
+
+describe('AIbertAI turn lease', () => {
+  it('binds one operation once and invalidates it on release', () => {
+    const lease = new AibertaiTurnLease('session-a')
+    expect(() => lease.admit('session-a', 'one')).toThrow()
+    expect(() => lease.bind('session-b', 'one')).toThrow()
+    lease.bind('session-a', 'one')
+    expect(() => lease.bind('session-a', 'two')).toThrow()
+    expect(() => lease.admit('session-b', 'one')).toThrow()
+    expect(() => lease.admit('session-a', 'two')).toThrow()
+    lease.admit('session-a', 'one')
+    expect(lease.allows('session-a', 'one')).toBe(true)
+    expect(() => lease.admit('session-a', 'one')).toThrow()
+    expect(() => lease.release('session-a', 'one')).toThrow()
+    lease.settled('session-a')
+    lease.release('session-a', 'one')
+    expect(lease.allows('session-a', 'one')).toBe(false)
+    expect(() => lease.bind('session-a', 'one')).toThrow()
+    lease.bind('session-a', 'two')
+    lease.admit('session-a', 'two')
+    expect(lease.allows('session-a', 'one')).toBe(false)
+    expect(lease.allows('session-a', 'two')).toBe(true)
+    lease.invalidate()
+    expect(lease.allows('session-a', 'two')).toBe(false)
+    expect(() => lease.bind('session-a', 'three')).toThrow()
+  })
+})
