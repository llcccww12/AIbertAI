+import { createHash } from 'node:crypto'
+
+/** Digest the exact host workspace value without persisting file contents. */
+export function aibertWorkspaceDigest(value: unknown): string {
+  if (value === null || typeof value !== 'object' || Array.isArray(value)) throw new TypeError('invalid workspace value')
+  const item = value as Record<string, unknown>
+  const { path, before, after } = item
+  const operation = item['operation'] ?? ''
+  if (typeof path !== 'string' || path === '' || typeof after !== 'string' || (before !== null && typeof before !== 'string')
+    || (operation !== '' && operation !== 'create' && operation !== 'update')
+    || (operation === 'create' && before !== null) || (operation !== 'create' && before === null)
+    || Buffer.byteLength(after, 'utf8') > 4 * 1024 * 1024 || (typeof before === 'string' && Buffer.byteLength(before, 'utf8') > 4 * 1024 * 1024)
+    || after.includes('\0') || (typeof before === 'string' && before.includes('\0'))) throw new TypeError('invalid workspace value')
+  const hash = createHash('sha256')
+  let size = 0
+  const put = (text: string): void => {
+    const bytes = Buffer.from(text, 'utf8')
+    const length = Buffer.alloc(8)
+    length.writeBigUInt64BE(BigInt(bytes.length))
+    hash.update(length).update(bytes)
+    size += length.length + bytes.length
+  }
+  put(path)
+  put(operation)
+  hash.update(Buffer.from([before === null ? 0 : 1]))
+  size++
+  if (typeof before === 'string') put(before)
+  put(after)
+  return `v1:${size}:${hash.digest('hex')}`
+}
