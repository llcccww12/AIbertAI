+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { createHash } from 'node:crypto'
+import { mkdtemp,rm } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { HistoryImportPrototype } from '../src/history-import-prototype.ts'
+const hash=x=>createHash('sha256').update(x).digest('hex')
+const identity={actorId:'11111111-1111-4111-8111-111111111111',workspaceId:'22222222-2222-4222-8222-222222222222'}
+const target='44444444-4444-4444-8444-444444444444', migration='33333333-3333-4333-8333-333333333333'
+function sourceFor(status='failed',change=()=>{}) {
+ const call={id:'call-1',name:'read',input:{path:'note'},output:'result',outputLength:6,status}
+ const rows=[{version:11,from_seq:1,to_seq:3,message:{id:'a',role:'user',at:1700000000000,parts:[{type:'text',text:'question'}]},toolCalls:{}},{version:11,from_seq:1,to_seq:3,message:{id:'b',role:'assistant',at:1700000000100,parts:[{type:'text',text:'checking'},{type:'tool_call',toolCallId:'call-1'},{type:'text',text:'answer'}]},toolCalls:{'call-1':call}}]
+ change(rows)
+ const replay=rows.map(row=>Buffer.from(JSON.stringify(row)).toString('base64'))
+ const meta={id:'55555555-5555-4555-8555-555555555555',status:'idle',schema_version:8,replay_version:11,replay_applied_seq:3,last_event_seq:3,message_count:2,replay_bytes:rows.reduce((n,row)=>n+Buffer.byteLength(JSON.stringify(row))+1,0),model:'66666666-6666-4666-8666-666666666666'}
+ const metadata=Buffer.from(JSON.stringify(meta)).toString('base64')
+ const legacyArchive={metadata,replay,sha256:hash(JSON.stringify({metadata,replay}))}
+ const legacySnapshot=JSON.stringify({sessionId:meta.id,state:'idle',model:meta.model,turns:[{operationId:'77777777-7777-4777-8777-777777777777',acked:true,prompt:'question',answer:'answer',toolRuns:[{preamble:'checking',call:{id:'call-1',type:'function',function:{name:'read',arguments:'{"path":"note"}'}},report:{failed:status==='failed'?1:0},output:'result'}]}]})
+ return JSON.stringify({legacySnapshot,attachments:[],legacyArchive,messages:[{role:'user',content:'question'},{role:'assistant',content:'checking',toolCall:{id:'call-1',name:'read',arguments:'{"path":"note"}'}},{role:'tool',content:'result',callId:'call-1',isError:status==='failed'},{role:'assistant',content:'answer'}]})
+}
+const input=source=>({version:1,migrationId:migration,targetSessionId:target,source,sourceSha256:hash(source)})
+test('archive tool success and failure remain paired; tampering is refused',async t=>{
+ for(const status of ['completed','failed']) {
+  const root=await mkdtemp(join(tmpdir(),'dsh-archive-tool-'));t.after(()=>rm(root,{recursive:true,force:true}));const importer=new HistoryImportPrototype(root)
+  const source=sourceFor(status);assert.equal((await importer.prepare(identity,input(source))).messages,4)
+ }
+ for(const change of [rows=>{rows[1].toolCalls['call-1'].outputTruncated=true},rows=>{delete rows[1].toolCalls['call-1']},rows=>{rows[1].toolCalls['call-1'].output='forged'},rows=>{rows[1].toolCalls['call-1'].input.path='other'}]) {
+  const root=await mkdtemp(join(tmpdir(),'dsh-archive-tool-bad-'));t.after(()=>rm(root,{recursive:true,force:true}));const importer=new HistoryImportPrototype(root)
+  await assert.rejects(()=>importer.prepare(identity,input(sourceFor('failed',change))),/unsupported_import_history/)
+ }
+})
+
+test('workspace manifest requires exact bytes, safe paths and bounded metadata',async t=>{
+ const make=entries=>{const value=JSON.parse(sourceFor('completed'));const raw=JSON.stringify(entries);value.legacyArchive.workspace={entries,raw:Buffer.from(raw).toString('base64'),sha256:hash(raw)};return JSON.stringify(value)}
+ const valid=[{path:'docs',directory:true},{path:'docs/note.txt',size:5,sha256:hash('hello'),mode:420}]
