+/** One SDK process is leased to one host session. A turn may be admitted once. */
+export class AibertaiTurnLease {
+  private current: { readonly operationId: string; admitted: boolean; active: boolean } | undefined
+  private readonly used = new Set<string>()
+  private invalid = false
+
+  constructor(readonly sessionId: string) {}
+
+  bind(sessionId: string, operationId: string): void {
+    if (this.invalid || sessionId !== this.sessionId || this.current !== undefined || this.used.has(operationId)) throw new Error('turn lease unavailable')
+    this.current = { operationId, admitted: false, active: false }
+    this.used.add(operationId)
+  }
+
+  admit(sessionId: string, operationId: string | undefined): void {
+    const current = this.current
+    if (this.invalid || sessionId !== this.sessionId || current === undefined || operationId !== current.operationId || current.admitted) throw new Error('turn lease mismatch')
+    current.admitted = true
+    current.active = true
+  }
+
+  settled(sessionId: string): void {
+    if (this.invalid || sessionId !== this.sessionId || this.current === undefined || !this.current.active) throw new Error('turn lease mismatch')
+    this.current.active = false
+  }
+
+  release(sessionId: string, operationId: string): void {
+    const current = this.current
+    if (this.invalid || sessionId !== this.sessionId || current === undefined || operationId !== current.operationId || !current.admitted || current.active) throw new Error('turn lease unavailable')
+    this.current = undefined
+  }
+
+  allows(sessionId: string, operationId: string): boolean {
+    const current = this.current
+    return !this.invalid && sessionId === this.sessionId && current?.operationId === operationId && current.active
+  }
+
+  invalidate(): void { this.invalid = true; this.current = undefined }
+}
