+  else if(message.role==='assistant' && turn){turn.answer=message.content}
+ }
+ return JSON.stringify({state:'idle',turns})
+}
+const input = raw => {const parsed=JSON.parse(raw);const source=JSON.stringify({legacySnapshot:snapshot(parsed.messages),attachments:[],...parsed});return {...base,source,sourceSha256:createHash('sha256').update(source).digest('hex')}}
