+ const original=JSON.parse(snapshot(messages));original.sessionId='55555555-5555-4555-8555-555555555555';original.model='66666666-6666-4666-8666-666666666666'
+ const records=messages.map((message,i)=>JSON.stringify({version:11,from_seq:1,to_seq:4,message:{id:String(i),role:message.role,at:1700000000000+i,parts:[{type:'text',text:message.content}]},toolCalls:{}}))
+ const metadata=JSON.stringify({id:original.sessionId,status:'idle',schema_version:8,replay_version:11,replay_applied_seq:4,last_event_seq:4,message_count:2,replay_bytes:records.reduce((n,row)=>n+Buffer.byteLength(row)+1,0),model:original.model})
+ const archive={metadata:Buffer.from(metadata).toString('base64'),replay:records.map(row=>Buffer.from(row).toString('base64'))};archive.sha256=createHash('sha256').update(JSON.stringify(archive)).digest('hex')
+ const source=JSON.stringify({legacySnapshot:JSON.stringify(original),messages,attachments:[],legacyArchive:archive});const request={...base,source,sourceSha256:createHash('sha256').update(source).digest('hex')}
