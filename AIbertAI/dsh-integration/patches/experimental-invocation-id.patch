+import type { Context } from '@deepseek-ai/cordis'
+import type { SessionEvent, SessionId } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-session-persistence'
+import type {} from '@deepseek-ai/dsh-subagent'
+
+export interface MemberPrompt {
+  readonly memberId: SessionId
+  readonly requestId: string
+  readonly text: string
+  readonly clientTimeZone?: string
+}
+
+export function parseMemberPrompt(params: Record<string, unknown>): MemberPrompt {
+  const { memberId, requestId, text, clientTimeZone } = params
+  if (typeof memberId !== 'string' || !memberId || memberId.length > 256 || typeof requestId !== 'string'
+    || !/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i.test(requestId)
+    || typeof text !== 'string' || !text.trim() || Buffer.byteLength(text) > 16384
+    || (clientTimeZone !== undefined && (typeof clientTimeZone !== 'string' || clientTimeZone.length > 128))) throw new Error('invalid_member_prompt')
+  return { memberId: memberId as SessionId, requestId, text, ...(clientTimeZone === undefined ? {} : { clientTimeZone }) }
+}
+
+/** Only offer historical links backed by the SDK's creator catalog and activation result. */
+export function creationCallIds(events: readonly SessionEvent[]): Map<SessionId, string> {
+  const catalog = new Map<string, SessionId>()
+  const calls = new Map<SessionId, string>()
+  for (const e of events) {
+    if (e.type === 'subagent/catalog' && 'name' in e.data) catalog.set(e.data.name, e.data.childId)
+    if (e.type !== 'tool/result' || typeof e.surfaceOp === 'object' || e.data.message.isError) continue
+    const meta = e.data.meta
+    if (typeof meta !== 'object' || meta === null || !('kind' in meta) || meta.kind !== 'activation'
+      || !('name' in meta) || typeof meta.name !== 'string') continue
+    const id = catalog.get(meta.name)
+    if (id) { calls.set(id, e.data.message.source.callId); catalog.delete(meta.name) }
+  }
+  return calls
+}
+
+async function memberArchive(ctx: Context, root: SessionId, id: SessionId) {
+  const members = await ctx.get('subagents')?.listDescendants(root) ?? []
+  const member = members.find(m => m.kind === 'child' && m.id === id)
+  if (member?.kind !== 'child' || member.mode !== 'continuable') throw new Error('dsh_member_unavailable')
+  const session = ctx.sessions.get(id)
+  if (session && !await ctx.sessions.flush(session)) throw new Error('member archive unavailable')
+  const handle = await ctx.sessionPersistence.open(id, 'read')
+  try {
+    if (handle.header.origin !== 'subagent' || handle.header.parentSession !== member.parentId) throw new Error('member lineage mismatch')
+    return (await handle.read(handle.inheritedEventCount)).events
+  } finally { await handle.close() }
+}
+
+function acceptedMessage(events: readonly SessionEvent[], input: MemberPrompt) {
+  let id: string | undefined
+  for (const e of events) {
+    if (e.type !== 'agent/inbox/spliced') continue
+    for (const m of e.data.inserted) {
+      if (m.source.kind !== 'user' || !('rpcId' in m.source) || m.source.rpcId !== input.requestId) continue
+      if (id && id !== m.id || m.content.length !== 1 || m.content[0]?.type !== 'text' || m.content[0].text !== input.text) throw new Error('member_request_conflict')
+      id = m.id
+    }
+  }
+  return id
+}
+
+/** Idempotence is checked in the same durable child inbox that owns the actual human message. */
+export async function sendMemberPrompt(ctx: Context, root: SessionId, input: MemberPrompt, signal: AbortSignal, assertActive: () => void) {
+  const events = await memberArchive(ctx, root, input.memberId)
+  const stored = acceptedMessage(events, input)
+  if (stored) return { messageId: stored }
+  const service = ctx.subagents
+  assertActive()
+  const receipt = await service.prompt({ childSessionId: input.memberId,
+    requestId: input.requestId as Parameters<typeof service.prompt>[0]['requestId'],
+    delivery: 'steer', content: [{ type: 'text', text: input.text }],
+    ...(input.clientTimeZone ? { clientTimeZone: input.clientTimeZone } : {}) }, signal)
+  if (acceptedMessage(await memberArchive(ctx, root, input.memberId), input) !== receipt.messageId) throw new Error('member_admission_unverified')
+  return { messageId: String(receipt.messageId) }
+}
+
+/** Return the child's own durable outcome. Its model receipts still belong to the root lease. */
+export async function memberOutcome(ctx: Context, root: SessionId, input: MemberPrompt) {
+  const events = await memberArchive(ctx, root, input.memberId)
+  const id = acceptedMessage(events, input)
+  if (!id) throw new Error('member_admission_unverified')
+  let turn: number | undefined, target: number | undefined, reason: string | undefined
+  let answer = ''
+  for (const e of events) {
+    if (e.type === 'turn/start') turn = e.data.turn
+    if (e.type === 'user/message' && e.data.id === id && e.surfaceOp === 'append') target = turn
+    if (e.type === 'assistant/message' && e.data.turn === target && e.surfaceOp === 'append') {
+      const text = e.data.message.content.filter(b => b.type === 'text').map(b => b.text).join('')
+      if (text) answer = text
+    }
+    if (e.type === 'turn/end') {
+      if (e.data.turn === target) reason = e.data.reason.kind
+      turn = undefined
+    }
+  }
+  if (!reason) throw new Error('member_outcome_unverified')
+  return { reason, answer }
+}
