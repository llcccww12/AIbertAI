+ assert.deepEqual(await restarted.abort(identity,base.migrationId),{status:'cancelled'});assert.equal((await readdir(root)).filter(name=>name.endsWith('.chunk')||name.endsWith('.lock')||name.startsWith(`.${base.migrationId}.`)).length,0);assert.equal(await readFile(join(root,other),'utf8'),'other')
+ await assert.rejects(()=>restarted.chunk(identity,base.migrationId,0,0,data.subarray(0,chunk).toString('base64')),/chunk_unavailable/)
