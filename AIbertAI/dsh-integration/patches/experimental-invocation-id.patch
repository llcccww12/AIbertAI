+++ b/packages/sdk/server/tests/aibertai-settlement.spec.ts
@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest'
+import { aibertSettlement } from '../src/aibertai-settlement.ts'
+
+const e = (type: string, seq: number, data: Record<string, unknown>) => ({ type, seq, data })
+const id = 'id-one'
+const start = e('aibertai/invocation', 0, { invocationId: id, purpose: 'conversation' })
+
+describe('AIbertAI settlement correlation', () => {
+  it('requires one matching successful terminal record after its invocation', () => {
+    const message = e('assistant/message', 1, { invocationId: id, invocationFinish: 'stop' })
+    expect(aibertSettlement([start, message], id)).toEqual({ state: 'committed', seq: 1 })
+    expect(aibertSettlement([start, { ...message, data: { ...message.data, invocationId: 'other' } }], id)).toEqual({ state: 'unknown' })
+    expect(aibertSettlement([start, start, message], id)).toEqual({ state: 'unknown' })
+    expect(aibertSettlement([start, message, { ...message, seq: 2 }], id)).toEqual({ state: 'unknown' })
+    expect(aibertSettlement([start, { ...message, data: { ...message.data, interrupted: true } }], id)).toEqual({ state: 'failed', seq: 1 })
+    expect(aibertSettlement([start, { ...message, data: { ...message.data, invocationFinish: 'max-tokens' } }], id)).toEqual({ state: 'failed', seq: 1 })
+    expect(aibertSettlement([start, e('assistant/attempt', 1, { invocationId: id })], id)).toEqual({ state: 'failed', seq: 1 })
+  })
+  it('requires the matching complete compaction transaction', () => {
+    const begin = e('compaction/start', 0, { compactionId: 'c' })
+    const marker = e('aibertai/invocation', 1, { invocationId: id, purpose: 'compaction', compactionId: 'c' })
+    const summary = e('compaction/summary', 2, { invocationId: id, compactionId: 'c' })
+    const replacement = e('user/message', 3, {})
+    const end = e('compaction/end', 4, { compactionId: 'c' })
+    expect(aibertSettlement([begin, marker, summary, replacement, end], id)).toEqual({ state: 'committed', seq: 4 })
+    expect(aibertSettlement([begin, marker, summary, replacement], id)).toEqual({ state: 'unknown' })
+    expect(aibertSettlement([begin, marker, e('compaction/end', 2, { compactionId: 'c', error: 'failed' })], id)).toEqual({ state: 'failed', seq: 2 })
+    expect(aibertSettlement([begin, marker, { ...summary, data: { invocationId: 'different', compactionId: 'c' } }, replacement, end], id)).toEqual({ state: 'unknown' })
+  })
+  it('returns usage only from the exact committed durable record', () => {
+    const usage = { inputTokens: 10, outputTokens: 4, cacheReadTokens: 2 }
+    const message = e('assistant/message', 1, { invocationId: id, invocationFinish: 'stop', usage })
+    expect(aibertSettlement([start, message], id)).toEqual({ state: 'committed', seq: 1, usageSeq: 1, usage })
+    expect(aibertSettlement([start, { ...message, data: { ...message.data, usage: { inputTokens: -1, outputTokens: 4 } } }], id)).toEqual({ state: 'committed', seq: 1 })
+    const begin = e('compaction/start', 0, { compactionId: 'c' })
+    const marker = e('aibertai/invocation', 1, { invocationId: id, purpose: 'compaction', compactionId: 'c' })
+    const summary = e('compaction/summary', 2, { invocationId: id, compactionId: 'c', usage })
+    expect(aibertSettlement([begin, marker, summary, e('user/message', 3, {}), e('compaction/end', 4, { compactionId: 'c' })], id)).toEqual({ state: 'committed', seq: 4, usageSeq: 2, usage })
+  })
+})
diff --git a/packages/sdk/server/tests/aibertai-turn-lease.spec.ts b/packages/sdk/server/tests/aibertai-turn-lease.spec.ts
