+/** Experimental import projection. Original bytes remain in the preparation record. */
+import { createHash } from 'node:crypto'
+import { Session, SessionId } from '@deepseek-ai/dsh-session'
+import { createUserMessage, createAssistantMessage, createToolResultMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import type { Prepared } from './history-import-prototype.ts'
+
+export function buildImportSeed(prepared: Prepared) {
+  const { messages } = JSON.parse(prepared.source) as { messages: Array<any> }
+  const session = Session.create(SessionId(prepared.targetSessionId))
+  session.append('aibertai/history-import', {version:1,migrationId:prepared.migrationId,actorId:prepared.actorId,workspaceId:prepared.workspaceId,sourceSha256:prepared.sourceSha256,source:prepared.source,messages:prepared.messages})
+  let turn = 0, step = 0, ordinal = 0
+  // The preparation is immutable; deterministic identities and timestamps allow
+  // a crash-restarted verifier to compare the whole imported prefix exactly.
+  const id = () => {
+    const hex = createHash('sha256').update(`${prepared.migrationId}:${ordinal++}`).digest('hex')
+    return `${hex.slice(0,8)}-${hex.slice(8,12)}-4${hex.slice(13,16)}-a${hex.slice(17,20)}-${hex.slice(20,32)}`
+  }
+  for (const message of messages) {
+    if (message.role === 'user') {
+      turn++; step = 1; session.append('turn/start', { turn }); session.append('step/start', { turn, step })
+      const value = { ...createUserMessage({ source: { kind:'user' }, content:[{ type:'text', text:message.content }] }), id:id() }
+      session.append('user/message', value as never, { surfaceOp:'append' })
+    } else if (message.role === 'assistant') {
+      const content: any[] = message.content ? [{type:'text',text:message.content}] : []
+      if (message.toolCall) content.push({type:'tool-call',id:ToolCallId(message.toolCall.id),name:message.toolCall.name,arguments:message.toolCall.arguments})
+      const value = { ...createAssistantMessage({source:{provider:'legacy',model:'legacy'},content}), id:id() }
+      session.append('assistant/message', {turn,step,message:value as never,stream:[]}, {surfaceOp:'append'})
+      if (message.toolCall) session.append('tool/call',{turn,step,callId:ToolCallId(message.toolCall.id),name:message.toolCall.name,arguments:message.toolCall.arguments})
+      else { session.append('step/end',{turn,step});session.append('turn/end',{turn,reason:{kind:'completed'}}) }
+    } else {
+      const value={...createToolResultMessage({callId:ToolCallId(message.callId),content:[{type:'text',text:message.content}],isError:message.isError}),id:id()}
+      session.append('tool/result',{turn,step,message:value as never},{surfaceOp:'append'})
+      session.append('step/end',{turn,step});step++;session.append('step/start',{turn,step})
+    }
+  }
+  return session.snapshotEvents().map(event => ({...event,time:0}))
+}
