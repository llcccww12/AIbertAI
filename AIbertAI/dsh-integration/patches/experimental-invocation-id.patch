+/** A child archive is read in bounded pages. Opaque tool metadata and binary bytes stay in the SDK. */
+function preview(parts: readonly string[], limit: number) {
+  let text = ''
+  let textLength = 0
+  for (const part of parts) {
+    textLength += part.length
+    if (text.length < limit) text += part.slice(0, limit - text.length)
+  }
+  if (text.length === textLength) return { text }
+  if (/[\uD800-\uDBFF]$/.test(text)) text = text.slice(0, -1)
+  return { text, textLength, truncated: true }
+}
+
+function messagePreview(blocks: readonly ContentBlock[], limit: number) {
+  const body = preview(blocks.filter(b => b.type === 'text').map(b => b.text), limit)
+  const files = blocks.filter(b => b.type === 'image' || b.type === 'file')
+  if (!files.length) return body
+  const attachments = files.slice(0, 16).map(b => ({
+    type: b.type, bytes: b.attachment.bytes, ...(b.attachment.name ? { name: b.attachment.name.slice(0, 256) } : {}),
+  }))
+  return { ...body, attachments, ...(files.length > attachments.length ? { attachmentCount: files.length } : {}) }
+}
+
+export function memberHistoryEntry(e: SessionEvent) {
+  const base = { seq: e.seq, time: e.time, type: e.type }
+  // A pruner/compactor rewrites the model surface. These are not new employee interactions.
+  if (typeof e.surfaceOp === 'object') return
+  switch (e.type) {
