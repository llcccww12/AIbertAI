{
  "manifest_version": 3,
  "name": "AIbertAI 浏览器助手",
  "version": "1.0.0",
  "description": "将当前标签页分享给本机 AIbertAI 客户端。",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
